# Supabase (service role key for backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Qdrant vector store (use http://localhost:6333 for local Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=chatbot_docs
QDRANT_FALLBACK_LOCAL=true

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email verification (Resend). Without RESEND_API_KEY, codes are logged and
# returned as dev_code for local testing.
RESEND_API_KEY=
EMAIL_FROM=NetBot <onboarding@resend.dev>
EMAIL_OTP_EXPIRE_MINUTES=10
EMAIL_DEV_EXPOSE_CODE=true

# Face login threshold (0-1 cosine similarity)
FACE_MATCH_THRESHOLD=0.70
